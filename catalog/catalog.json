    {
      "repo": "bruceborrett/easy-enclosure",
      "fallback": {
        "id": "easy-enclosure",
        "name": "Easy Enclosure",
        "summary": "Design 3D-printable enclosures for electronics with snap-fit lids, PCB standoffs and cable clamps; exports STL and STEP.",
        "description": "EasyEnclosure is an open-source 3D modeling tool for designing 3D-printable enclosures. An intuitive interface and a set of user-friendly controls let anyone create custom enclosures for electronic projects, prototypes or DIY gadgets.",
        "tags": [
          "enclosure",
          "electronics",
          "step",
          "stl"
        ],
        "process": "3d-print",
        "license": "MIT",
        "homepage": "https://easyenclosure.org/",
        "icon": "public/easy-enclosure-logo.svg",
        "distributions": [
          {
            "kind": "web",
            "url": "https://easyenclosure.org/",
            "label": "Open online"
          },
          {
            "kind": "bundle",
            "label": "Build offline copy",
            "from": {
              "type": "repo"
            },
            "build": {
              "output": "dist/angular-app/browser",
              "steps": [
                [
                  "node",
                  "scripts/sync-version.js"
                ],
                [
                  "npx",
                  "ng",
                  "build",
                  "--base-href",
                  "./"
                ]
              ],
              "env": {
                "NG_CLI_ANALYTICS": "false"
              }
            },
            "spa": true,
            "notes": "Built on your computer from Bruce Borrett's repository with the library's own Node.js, so it follows the latest upstream changes."
          }
        ],
        "screenshots": [
          "public/screenshot.png"
        ]
      }
    },
