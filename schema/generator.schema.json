{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DrFlGd/Generator-Library/main/schema/generator.schema.json",
  "title": "Generator manifest (generator.json)",
  "description": "Describes one model generator so Generator Library can list, install, launch and update it.",
  "type": "object",
  "required": [
    "id",
    "name",
    "distributions"
  ],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Stable, unique, lowercase. Changing it makes the library treat the generator as new."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "Informational; the library tracks release tags and commits for updates."
    },
    "summary": {
      "type": "string",
      "description": "One sentence shown on the card."
    },
    "description": {
      "type": "string",
      "description": "Longer text shown in the detail view. Newlines are kept."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "process": {
      "type": "string",
      "description": "What the output is for: 3d-print, laser, cnc, tool…"
    },
    "category": {
      "type": "string",
      "description": "One lowercase word or slug for the filter panel, e.g. storage, mechanical, signs-text, ai-3d, cad."
    },
    "pricing": {
      "enum": ["free", "freemium", "paid"],
      "description": "What using the generator costs: free, free with paid extras, or paid."
    },
    "account": {
      "type": "boolean",
      "description": "True when downloading a model needs a sign-up."
    },
    "exports": {
      "type": "array",
      "items": { "type": "string" },
      "description": "File types it makes, lowercase: stl, 3mf, step, svg…"
    },
    "openSource": {
      "type": "boolean",
      "description": "Whether its source is published. Defaults to true when it has a repo."
    },
    "listing": {
      "type": "string",
      "pattern": "^https://",
      "description": "The directory page it was imported from, if any."
    },
    "icon": {
      "type": "string",
      "description": "Path in the repository, or an https URL."
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier."
    },
    "author": {
      "type": "string"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "description": "owner/name on GitHub. Defaults to the repository the manifest was read from."
    },
    "upstream": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "description": "For forks: the original repository, shown as a link."
    },
    "requires": {
      "$ref": "#/$defs/requires"
    },
    "distributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/distribution"
      }
    }
  },
  "$defs": {
    "from": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "asset"
          ],
          "properties": {
            "type": {
              "const": "release"
            },
            "repo": {
              "type": "string",
              "description": "Release repository when it differs from the manifest's repo (for example the upstream of a fork)."
            },
            "tag": {
              "type": "string",
              "default": "latest",
              "description": "\"latest\", an exact tag, or a glob such as desktop-v*."
            },
            "asset": {
              "type": "string",
              "description": "Asset file name or glob, e.g. Terrain-Press-*-Portable.exe"
            },
            "prerelease": {
              "type": "boolean",
              "default": false,
              "description": "Also consider pre-releases."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "repo"
            },
            "repo": {
              "type": "string"
            },
            "ref": {
              "type": "string",
              "description": "Branch or tag; default branch when omitted."
            },
            "path": {
              "type": "string",
              "description": "Folder inside the repository to install, e.g. site or dist. Empty means the whole tree."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "url",
            "asset"
          ],
          "properties": {
            "type": {
              "const": "page"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://",
              "description": "The project's download page. The newest file it links to whose name matches asset is installed, and a new file name there is an update."
            },
            "asset": {
              "type": "string",
              "description": "File name or glob, e.g. MiniSkylines-Desktop-*-setup.exe"
            },
            "folder": {
              "type": "string",
              "pattern": "^https?://",
              "description": "Where a file name the page's scripts hold on its own is downloaded from, e.g. https://example.com/downloads/"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "distribution": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "web",
            "bundle",
            "exe",
            "mirror"
          ]
        },
        "label": {
          "type": "string",
          "description": "Button text. Defaults per kind."
        },
        "notes": {
          "type": "string"
        },
        "platform": {
          "enum": [
            "windows",
            "macos",
            "linux"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "web and mirror: the page to open or capture."
        },
        "githubPagesFiles": {
          "type": "boolean",
          "description": "mirror: also pull every published repository file (WebMirror's GitHub Pages mode)."
        },
        "browserCapture": {
          "type": "boolean",
          "default": true,
          "description": "mirror: capture JavaScript-loaded assets with a local Chrome/Edge."
        },
        "from": {
          "$ref": "#/$defs/from",
          "description": "bundle and exe: where the files come from."
        },
        "entry": {
          "type": "string",
          "default": "index.html",
          "description": "bundle: page to open, relative to the unpacked folder."
        },
        "spa": {
          "type": "boolean",
          "default": false,
          "description": "bundle: serve the entry page for unknown routes (client-side routing)."
        },
        "install": {
          "enum": [
            "portable",
            "installer",
            "zip"
          ],
          "default": "portable",
          "description": "exe: portable runs the file; installer runs it once to install; zip unpacks and runs exec."
        },
        "exec": {
          "type": "string",
          "description": "exe: executable path inside the unpacked archive (zip) or the file the installer leaves behind."
        },
        "requires": {
          "$ref": "#/$defs/requires"
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "description": "bundle with a repo \"from\": build the web app from its source with the library's private Node.js, then host the output folder.",
          "properties": {
            "output": {
              "type": "string",
              "default": "dist",
              "description": "Folder the build writes, relative to the repository (or from.path)."
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "default": [
                [
                  "npm",
                  "run",
                  "build"
                ]
              ],
              "description": "Commands run after npm installs the dependencies. Each is an argument list starting with npm, npx or node.",
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "prefixItems": [
                  {
                    "enum": [
                      "npm",
                      "npx",
                      "node"
                    ]
                  }
                ]
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Environment variables for the install and build steps."
            },
            "installScripts": {
              "type": "boolean",
              "default": false,
              "description": "Run dependency install scripts (postinstall and the like). Off unless the build needs them."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "web"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mirror"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "bundle"
              }
            }
          },
          "then": {
            "required": [
              "from"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "exe"
              }
            }
          },
          "then": {
            "required": [
              "from",
              "platform"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "requires": {
      "type": "array",
      "description": "Runtimes the library installs privately before installing or launching (see docs/MANIFEST.md).",
      "items": {
        "type": "object",
        "required": [
          "runtime"
        ],
        "additionalProperties": false,
        "properties": {
          "runtime": {
            "enum": [
              "python",
              "node"
            ],
            "description": "python: a private CPython with pip packages. node: a private Node.js with npm (added automatically for a build)."
          },
          "packages": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "A pip requirement spec."
                },
                {
                  "type": "object",
                  "required": [
                    "spec"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "spec": {
                      "type": "string"
                    },
                    "import": {
                      "type": "string",
                      "description": "Module to import to check it is there."
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
