{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DrFlGd/Generator-Library/main/schema/catalog.schema.json",
  "title": "Generator Library catalog",
  "type": "object",
  "required": ["version", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "version": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo"],
        "properties": {
          "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "manifest": { "type": "string", "description": "Path of the manifest in the repository. Default: generator.json, then generator-library.json, at the root." },
          "overlay": { "type": "object", "description": "A generator or collection manifest merged over what the repository publishes (overlay wins)." },
          "overlayOnly": { "type": "boolean", "description": "Do not read the repository; use the overlay alone." },
          "enabled": { "type": "boolean", "default": true },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
